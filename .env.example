# =====================================================================
# RoomSplits Environment Variables Template (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real credentials to source control.
# =====================================================================

# Supabase Public Configuration (Phase 8B)
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional alias for backward compatibility with older tutorials
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (Phase 9+ Admin / Migrations)
# NEVER prefix with NEXT_PUBLIC_ or expose to client bundles
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay Payments (Configured in Payment Phase)
# Server-side secrets MUST NEVER be imported in client components
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Google Maps API (Optional future phase)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
